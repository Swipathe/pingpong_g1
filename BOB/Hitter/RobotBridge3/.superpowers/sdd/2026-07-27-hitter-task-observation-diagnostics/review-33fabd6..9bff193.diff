+            ),
+            received_s=1.01,
+        )
+
+        self.assertEqual(visible.snapshot.track_epoch, 0)
+        self.assertEqual(visible.snapshot.generation, 1)
+        self.assertEqual(invalid.snapshot.track_epoch, 1)
