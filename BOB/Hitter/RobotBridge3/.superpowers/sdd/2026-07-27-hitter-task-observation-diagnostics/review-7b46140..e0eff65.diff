+
+
+_RECENT_ATTEMPT_LIMIT = 100
+_MIN_EVENT_BYTES = 1024
+
+
+class _InvalidDraft(ValueError):
+    pass
+
+
+class _EventTooLarge(ValueError):
+    pass
