+from diagnostics.hitter_task_models import (
+    SCHEMA_VERSION,
+    AttemptSummary,
+    EventDraft,
+    HealthSnapshot,
+    JsonValue,
+    LifecycleSnapshot,
+    SnapshotKey,
+    freeze_json_value,
+    to_builtin_json,
