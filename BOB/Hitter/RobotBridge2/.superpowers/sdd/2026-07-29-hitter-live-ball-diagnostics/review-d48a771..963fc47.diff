+class BallDiagnosticTracker:
+    """Track ball-only estimator and incoming state without production gates."""
+
+    def __init__(
+        self,
+        *,
+        estimator_window_size: Optional[int],
+        minimum_speed_x_mps: float,
+        required_consecutive_snapshots: int,
+    ) -> None:
+        self.estimator_window_size = (
+            None
+            if estimator_window_size is None
+            else int(estimator_window_size)
+        )
+        if (
+            self.estimator_window_size is not None
+            and self.estimator_window_size < 1
+        ):
+            raise ValueError("estimator_window_size must be positive")
+        self.minimum_speed_x_mps = float(minimum_speed_x_mps)
+        if (
+            not np.isfinite(self.minimum_speed_x_mps)
+            or self.minimum_speed_x_mps <= 0.0
+        ):
+            raise ValueError(
+                "minimum_speed_x_mps must be finite and positive"
+            )
+        self.required_consecutive_snapshots = int(
+            required_consecutive_snapshots
+        )
+        if self.required_consecutive_snapshots < 1:
+            raise ValueError(
+                "required_consecutive_snapshots must be positive"
+            )
+        self._lock = threading.RLock()
+        self._last_key: Optional[SnapshotKey] = None
+        self._track_epoch: Optional[int] = None
+        self._incoming_count = 0
+        self._state = self._unavailable_state(
+            status="NOT_SEEN",
+            incoming_status="NOT_EVALUATED",
+            blocker="BALL_NOT_SEEN",
+        )
+
+    def _unavailable_state(
+        self,
+        *,
+        status: str,
+        incoming_status: str,
+        blocker: str,
+    ) -> BallDiagnosticState:
+        return BallDiagnosticState(
+            status=status,
+            estimator_sample_count=None,
+            estimator_window_size=self.estimator_window_size,
+            speed_mps=None,
+            velocity_world_mps=None,
+            incoming_count=None,
+            incoming_required_count=(
+                self.required_consecutive_snapshots
+            ),
+            incoming_status=incoming_status,
+            blocker=blocker,
+        )
+
+    def reset(self, *, blocker: str) -> BallDiagnosticState:
+        with self._lock:
+            self._last_key = None
+            self._track_epoch = None
+            self._incoming_count = 0
+            self._state = self._unavailable_state(
+                status="TRACK_ENDED",
+                incoming_status="TRACK_ENDED",
+                blocker=str(blocker),
+            )
+            return self._state
+
+    def observe(
+        self,
+        snapshot: BallEstimateSnapshot,
+        *,
+        estimator_sample_count: Optional[int],
+    ) -> BallDiagnosticState:
+        key = SnapshotKey(
+            int(snapshot.track_epoch),
+            int(snapshot.generation),
+        )
+        with self._lock:
+            if key == self._last_key:
+                return self._state
+            self._last_key = key
+            if self._track_epoch != key.track_epoch:
+                self._track_epoch = key.track_epoch
+                self._incoming_count = 0
+
+            if not bool(snapshot.visible):
+                self._track_epoch = None
+                self._incoming_count = 0
+                self._state = self._unavailable_state(
+                    status="TRACK_ENDED",
+                    incoming_status="TRACK_ENDED",
+                    blocker="BALL_NOT_VISIBLE",
+                )
+                return self._state
+
+            sample_count = (
+                None
+                if estimator_sample_count is None
+                else int(estimator_sample_count)
+            )
+            if not bool(snapshot.ready):
+                self._state = BallDiagnosticState(
+                    status="ESTIMATING",
+                    estimator_sample_count=sample_count,
+                    estimator_window_size=self.estimator_window_size,
+                    speed_mps=None,
+                    velocity_world_mps=None,
+                    incoming_count=None,
+                    incoming_required_count=(
+                        self.required_consecutive_snapshots
+                    ),
+                    incoming_status="NOT_EVALUATED",
+                    blocker="ESTIMATOR_WARMING",
+                )
+                return self._state
+
+            velocity = np.asarray(
+                snapshot.velocity_w,
+                dtype=np.float64,
+            ).reshape(-1)
+            if velocity.shape != (3,) or not np.isfinite(velocity).all():
+                self._incoming_count = 0
+                self._state = BallDiagnosticState(
+                    status="INVALID",
+                    estimator_sample_count=sample_count,
+                    estimator_window_size=self.estimator_window_size,
+                    speed_mps=None,
+                    velocity_world_mps=None,
+                    incoming_count=None,
+                    incoming_required_count=(
+                        self.required_consecutive_snapshots
+                    ),
+                    incoming_status="NOT_EVALUATED",
+                    blocker="ESTIMATE_NONFINITE",
+                )
+                return self._state
+
+            velocity_tuple = tuple(float(value) for value in velocity)
+            incoming = bool(
+                velocity_tuple[0] <= -self.minimum_speed_x_mps
+            )
+            if incoming:
+                self._incoming_count = min(
+                    self._incoming_count + 1,
+                    self.required_consecutive_snapshots,
+                )
+            else:
+                self._incoming_count = 0
+            self._state = BallDiagnosticState(
+                status="READY",
+                estimator_sample_count=sample_count,
+                estimator_window_size=self.estimator_window_size,
+                speed_mps=float(np.linalg.norm(velocity)),
+                velocity_world_mps=velocity_tuple,
+                incoming_count=int(self._incoming_count),
+                incoming_required_count=(
+                    self.required_consecutive_snapshots
+                ),
+                incoming_status=(
+                    "INCOMING" if incoming else "NOT_INCOMING"
+                ),
+                blocker=(
+                    None
+                    if incoming
+                    else "INCOMING_SPEED_REJECTED"
+                ),
+            )
+            return self._state
+
+    def snapshot(self) -> BallDiagnosticState:
+        with self._lock:
+            return self._state
+
