+                    ("ESTIMATOR_READY", None),
+                    ("INCOMING_CONFIRMED", None),
+                    ("PLANNED", None),
+                    ("ARMED", None),
+                    ("TASK_OBS_FAILED", "OBS_CLIPPED"),
+                ),
+                "OBS_CLIPPED",
+                "FAILED",
+            ),
+            (
+                "pass_wins",
+                (
+                    ("ESTIMATOR_READY", None),
+                    ("INCOMING_CONFIRMED", None),
+                    ("PLANNED", None),
+                    ("ARMED", None),
+                    ("TASK_OBS_PASS", None),
