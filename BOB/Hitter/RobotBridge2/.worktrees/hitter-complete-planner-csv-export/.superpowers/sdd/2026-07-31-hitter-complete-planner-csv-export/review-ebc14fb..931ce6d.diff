+def _write_task_observations_csv(
+    output_path: Path,
+    details: Mapping[int, Mapping[str, Any]],
+) -> int:
+    rows = []
+    for attempt_id in sorted(details):
+        detail = details[attempt_id]
+        pre = detail["task_observation_pre_clip"]
+        post = detail["task_observation_post_clip"]
+        clip_count = detail["task_observation_clip_count"]
+        if pre is None and post is None and clip_count is None:
+            pre_values = (None,) * TASK_OBSERVATION_DIMENSIONS
+            post_values = (None,) * TASK_OBSERVATION_DIMENSIONS
+        else:
+            if not isinstance(pre, list) or not isinstance(post, list):
+                raise ValueError(
+                    "task observation pre/post vectors must both be lists "
+                    "for attempt {}".format(attempt_id)
+                )
+            if (
+                len(pre) != TASK_OBSERVATION_DIMENSIONS
+                or len(post) != TASK_OBSERVATION_DIMENSIONS
+            ):
+                raise ValueError(
+                    "task observation vectors must have {} dimensions "
+                    "for attempt {}".format(
+                        TASK_OBSERVATION_DIMENSIONS,
+                        attempt_id,
+                    )
+                )
+            pre_values = tuple(
+                _require_finite_float(
+                    value,
+                    field="task observation pre_clip",
+                )
+                for value in pre
+            )
+            post_values = tuple(
+                _require_finite_float(
+                    value,
+                    field="task observation post_clip",
+                )
+                for value in post
+            )
+            clip_count = _require_int(
+                clip_count,
+                field="task observation clip_count",
+                minimum=0,
+            )
+        row: Dict[str, Any] = {
+            "attempt_id": attempt_id,
+            "clip_count": clip_count,
+        }
+        for index, value in enumerate(pre_values):
+            row["pre_{}".format(index)] = value
+        for index, value in enumerate(post_values):
+            row["post_{}".format(index)] = value
+        rows.append(row)
+    return _write_csv_rows(
+        output_path,
+        _TASK_OBSERVATION_FIELDS,
+        rows,
+    )
