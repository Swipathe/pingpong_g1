+def _truncate_utf8(value: object, maximum_bytes: int) -> str:
+    encoded = str(value).encode("utf-8", errors="replace")[:maximum_bytes]
+    while True:
+        try:
+            return encoded.decode("utf-8")
+        except UnicodeDecodeError:
+            encoded = encoded[:-1]
