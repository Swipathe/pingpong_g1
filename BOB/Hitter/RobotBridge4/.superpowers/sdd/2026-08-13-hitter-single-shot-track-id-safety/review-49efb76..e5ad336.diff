+        ),
+    }
+    for name, value in values.items():
+        if not np.isfinite(value) or value <= 0.0:
+            raise ValueError(
+                f"HITTER Vicon {name} must be finite and positive."
+            )
+
+    return ViconConsumerSettings(
+        channel=channel,
+        base_subject=base_subject,
