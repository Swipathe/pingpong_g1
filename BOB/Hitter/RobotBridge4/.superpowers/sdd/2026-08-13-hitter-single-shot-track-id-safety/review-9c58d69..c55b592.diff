+bool ParseFinitePositiveDoubleStrict(
+    const std::string& text, double* value) {
+  try {
+    size_t consumed = 0;
+    const double parsed = std::stod(text, &consumed);
+    if (consumed != text.size() || !std::isfinite(parsed) || parsed <= 0.0) {
+      return false;
+    }
+    *value = parsed;
+    return true;
+  } catch (const std::exception&) {
+    return false;
+  }
