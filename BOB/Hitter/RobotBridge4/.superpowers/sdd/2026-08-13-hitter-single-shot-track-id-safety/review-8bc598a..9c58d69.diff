+  const BallTrackUpdate ended = AdvanceBallTrack(
+      &state, {}, 125, 1.25, 0.35, 0.25, 1999999);
+  const BallTrackUpdate next = AdvanceBallTrack(
+      &state, {Candidate(0.90, 0.0, 1.0)}, 126, 1.26,
