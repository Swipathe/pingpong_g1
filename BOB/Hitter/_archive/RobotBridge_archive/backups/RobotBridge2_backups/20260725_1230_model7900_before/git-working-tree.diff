-            msg=msg,
-            status="planned",
-            estimate=estimate,
-            decision=decision,
-            time_to_strike_s=float(command.time_to_strike),
-            policy_time_to_strike_s=self.lifecycle.policy_tts(now=received),
-            strike_type=str(command.strike_type),
