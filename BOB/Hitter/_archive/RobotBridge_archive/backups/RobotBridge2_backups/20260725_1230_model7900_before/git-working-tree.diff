-        if result is not None and int(result.source_generation) >= int(generation):
-            return result
-        time.sleep(0.0005)
-    raise AssertionError(
-        "planner worker did not complete generation {} within {:.1f}s".format(
-            generation,
-            timeout_s,
-        )
-    )
