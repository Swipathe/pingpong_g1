+@dataclass(frozen=True)
+class PublishedEvent:
+    schema_version: int
+    event_id: int
+    kind: str
+    monotonic_s: float
+    wall_time_us: int
+    scope: str
+    attempt_id: Optional[int]
+    payload: Mapping[str, JsonValue]
