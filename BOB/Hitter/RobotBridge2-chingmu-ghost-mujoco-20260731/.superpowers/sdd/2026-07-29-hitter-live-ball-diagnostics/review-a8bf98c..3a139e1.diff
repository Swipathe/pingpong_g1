+      setText(
+        byId('ball-estimated-position-value'),
+        formatVector(ball.estimated_position_w, 3, ' m'),
+      );
+      setText(
+        byId('ball-velocity-value'),
+        formatVector(ball.estimated_velocity_w, 3, ' m/s'),
+      );
+      const speedAvailable = (
+        ball.speed_mps !== null && ball.speed_mps !== undefined
+      );
+      const vxAvailable = (
+        ball.velocity_x_mps !== null && ball.velocity_x_mps !== undefined
+      );
+      setText(
+        byId('ball-speed-value'),
+        speedAvailable || vxAvailable
+          ? formatNumber(ball.speed_mps, 3, ' m/s')
+            + ' · vx ' + formatNumber(ball.velocity_x_mps, 3, ' m/s')
+          : '—',
+      );
+      setText(
+        byId('ball-identity-value'),
+        'track ' + formatOptional(ball.track_epoch, (item) => String(item))
+          + ' · gen ' + formatOptional(ball.generation, (item) => String(item))
+          + ' · frame ' + formatOptional(
+            ball.source_frame,
+            (item) => String(item),
+          )
+          + ' · age ' + formatNumber(ball.age_s, 3, ' s'),
+      );
+
+      const pelvisStatus = statusText(gate.pelvis_status);
+      setCardStatus('gate-pelvis-card', pelvisStatus);
+      setText(byId('gate-pelvis-value'), pelvisStatus);
+      setText(
+        byId('gate-pelvis-detail'),
+        'subject ' + statusText(pelvisSubject.status),
+      );
+
+      const productionIncomingStatus = statusText(
+        gate.production_incoming_status,
+      );
+      setCardStatus(
+        'gate-production-incoming-card',
+        productionIncomingStatus,
+      );
+      setText(
+        byId('gate-production-incoming-value'),
+        productionIncomingStatus + ' · ' + formatCountPair(
+          gate.production_incoming_count,
+          gate.production_incoming_required,
+        ),
+      );
+      setText(byId('gate-production-incoming-detail'), 'production gate');
+
+      const plannerStatus = statusText(gate.planner_status);
+      setCardStatus('gate-planner-card', plannerStatus);
