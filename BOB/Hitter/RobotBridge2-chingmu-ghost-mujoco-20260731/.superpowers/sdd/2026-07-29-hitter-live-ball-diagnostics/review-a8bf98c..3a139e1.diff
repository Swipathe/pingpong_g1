+          ['#' + attemptId, ''],
+          [formatNumber(row.ball_speed_mps, 2, ' m/s'), ''],
+          [
+            formatCountPair(
+              row.estimator_sample_count,
+              row.estimator_window_size,
+            ),
+            'history-estimator-' + attemptId,
+          ],
+          [
+            formatCountPair(
+              row.incoming_count,
+              row.incoming_required_count,
+            ),
+            'history-incoming-' + attemptId,
+          ],
+          [summaryCell(row, 'stage', '—'), ''],
+          [summaryCell(row, 'primary_blocker', '—'), ''],
+          [formatNumber(row.arm_tts_s, 3, ' s'), ''],
+          [summaryCell(row, 'task_obs_status', '—'), ''],
+          [summaryCell(row, 'ab_summary', 'pending'), ''],
+        ];
+        values.forEach(([value, id]) => {
+          const cell = makeElement('td', '', value);
+          if (id) {
+            cell.id = id;
+          }
+          tr.appendChild(cell);
+        });
+        const open = () => loadAttemptDetail(row.attempt_id);
+        tr.addEventListener('click', open);
+        tr.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            open();
+          }
+        });
+        body.appendChild(tr);
+      });
+    }
+
+    function renderHistoryRows(rows, append) {
+      const safeRows = Array.isArray(rows) ? rows : [];
+      if (!append) {
+        historyRows = [];
+      }
+      safeRows.forEach((row) => {
+        const index = historyRows.findIndex(
+          (item) => item.attempt_id === row.attempt_id,
+        );
+        if (index >= 0) {
+          historyRows[index] = row;
+        } else {
+          historyRows.push(row);
+        }
+      });
+      renderHistoryTable();
+    }
+
+    function mergeRecentHistoryRows(rows) {
+      const safeRows = Array.isArray(rows) ? rows : [];
+      const recentIds = new Set(safeRows.map((row) => row.attempt_id));
+      const recent = [];
+      safeRows.forEach((row) => {
+        if (recent.some((item) => item.attempt_id === row.attempt_id)) {
+          return;
+        }
+        recent.push(row);
+      });
+      historyRows = recent.concat(
+        historyRows.filter((row) => !recentIds.has(row.attempt_id)),
+      );
+      renderHistoryTable();
+    }
+
+    function pretty(value) {
+      return JSON.stringify(value === undefined ? null : value, null, 2);
+    }
+
+    function detailCard(title, value, wide) {
+      const card = makeElement('section', 'detail-card' + (wide ? ' wide' : ''));
+      card.appendChild(makeElement('h3', '', title));
+      const pre = document.createElement('pre');
+      setText(pre, pretty(value));
+      card.appendChild(pre);
+      return card;
+    }
+
+    function renderAttemptDetail(detail) {
+      const content = byId('detail-content');
+      content.className = 'detail-grid';
+      const summary = detail.summary || {};
+      content.replaceChildren(
+        detailCard('Primary blocker', summary.primary_blocker || 'none', false),
+        detailCard('11 维 pre-clip', detail.task_observation_pre_clip, false),
+        detailCard('11 维 post-clip', detail.task_observation_post_clip, false),
+        detailCard('clip count', detail.task_observation_clip_count, false),
+        detailCard('planner inputs', detail.planner_inputs, true),
+        detailCard('planner results', detail.planner_results, true),
+        detailCard('stage timeline', detail.stage_timeline, true),
+      );
+      const ab = byId('ab-content');
+      ab.className = 'detail-grid';
+      ab.replaceChildren(
+        detailCard('variant outcomes', detail.variant_outcomes, true),
+        detailCard('A/B deltas', detail.ab_deltas, true),
+      );
+    }
+
+    async function loadAttemptDetail(attemptId) {
+      const numeric = Number(attemptId);
+      if (!Number.isInteger(numeric) || numeric <= 0) {
+        return;
+      }
+      try {
+        const response = await fetch('/api/attempts/' + encodeURIComponent(String(numeric)), {
+          cache: 'no-store',
+        });
+        if (!response.ok) {
+          throw new Error('detail HTTP ' + String(response.status));
+        }
+        renderAttemptDetail(await response.json());
+      } catch (error) {
+        const content = byId('detail-content');
+        content.className = 'detail-empty';
+        setText(content, '详情暂不可用：' + String(error));
+      }
+    }
+
+    async function loadHistory(before, append) {
+      let url = '/api/attempts?limit=50';
+      if (before !== null && before !== undefined) {
+        url += '&before=' + encodeURIComponent(String(before));
+      }
+      const response = await fetch(url, {cache: 'no-store'});
+      if (!response.ok) {
+        throw new Error('history HTTP ' + String(response.status));
+      }
+      const page = await response.json();
+      renderHistoryRows(Array.isArray(page.items) ? page.items : [], append);
+      nextBefore = page.next_before;
+      byId('load-more').disabled = !page.has_more || nextBefore === null;
+    }
+
+    function renderState(state) {
+      const watermark = Number(state.watermark_event_id);
+      if (
+        Number.isFinite(watermark) &&
+        Number(state.watermark_event_id) < renderedWatermark
+      ) {
+        return;
+      }
+      if (Number.isFinite(watermark)) {
+        renderedWatermark = watermark;
+      }
+      renderHealth(state);
+      renderCurrentAttempt(state);
+      const rows = Array.isArray(state.recent_attempts) ? state.recent_attempts : [];
+      mergeRecentHistoryRows(rows);
+    }
+
+    async function performStateRefresh() {
+      if (requestInFlight) {
+        refreshPending = true;
+        return;
+      }
+      requestInFlight = true;
+      refreshPending = false;
+      lastRequestStartedMs = performance.now();
+      requestStartTimesMs = requestStartTimesMs.filter(
+        (atMs) => atMs > lastRequestStartedMs - REQUEST_WINDOW_MS,
+      );
+      requestStartTimesMs.push(lastRequestStartedMs);
+      try {
+        const response = await fetch('/api/state', {cache: 'no-store'});
+        if (!response.ok) {
+          throw new Error('state HTTP ' + String(response.status));
+        }
+        renderState(await response.json());
+      } catch (error) {
+        setConnection(false, '诊断服务断开，保留最近画面 · ' + String(error));
+      } finally {
+        requestInFlight = false;
+        if (refreshPending) {
+          scheduleStateRefresh();
+        }
+      }
+    }
+
+    function scheduleStateRefresh() {
+      refreshPending = true;
+      if (refreshTimer !== null) {
+        return;
+      }
+      const nowMs = performance.now();
+      requestStartTimesMs = requestStartTimesMs.filter(
+        (atMs) => atMs > nowMs - REQUEST_WINDOW_MS,
+      );
+      const elapsed = nowMs - lastRequestStartedMs;
+      const intervalWait = Math.max(
+        0,
+        MIN_REQUEST_INTERVAL_MS - elapsed,
+      );
+      const windowWait = requestStartTimesMs.length >= MAX_REQUESTS_PER_WINDOW
+        ? Math.max(
+          0,
+          requestStartTimesMs[0] + REQUEST_WINDOW_MS - nowMs,
+        )
+        : 0;
+      const wait = Math.max(intervalWait, windowWait);
+      refreshTimer = window.setTimeout(() => {
+        refreshTimer = null;
+        performStateRefresh();
+      }, wait);
+    }
+
+    function closeEvents() {
+      if (eventSource !== null) {
+        eventSource.close();
+        eventSource = null;
+      }
+    }
+
+    function connectEvents() {
+      closeEvents();
+      eventSource = new EventSource('/events');
+      eventSource.addEventListener('ready', () => {
+        reconnectDelayMs = 500;
+        scheduleStateRefresh();
+      });
+      eventSource.addEventListener('invalidate', () => {
+        scheduleStateRefresh();
+      });
+      eventSource.addEventListener('reset', () => {
+        scheduleStateRefresh();
+      });
+      eventSource.addEventListener('heartbeat', () => {
+        scheduleStateRefresh();
+      });
+      eventSource.onerror = () => {
+        setConnection(false, '事件流断开，正在重连；最近画面仍可查看');
+        closeEvents();
+        if (reconnectTimer !== null) {
+          window.clearTimeout(reconnectTimer);
+        }
+        reconnectTimer = window.setTimeout(() => {
+          reconnectTimer = null;
+          connectEvents();
+        }, reconnectDelayMs);
+        reconnectDelayMs = Math.min(reconnectDelayMs * 2, 10000);
+      };
+    }
+
+    byId('load-more').addEventListener('click', () => {
+      loadHistory(nextBefore, true).catch((error) => {
+        setConnection(false, '历史分页失败：' + String(error));
+      });
+    });
+
+    window.addEventListener('pagehide', () => {
+      closeEvents();
+      if (reconnectTimer !== null) {
+        window.clearTimeout(reconnectTimer);
+      }
+    });
+
+    scheduleStateRefresh();
+    loadHistory(null, false).catch(() => {});
+    connectEvents();
+  </script>
+</body>
+</html>
