+        *,
+        lcm_client: object,
+        decoder: Callable[[bytes], object],
+        adapter: object,
+        pipeline: object,
+        recorder: object,
+        web_server: object,
+        event_lane: object,
+        event_hub: object,
+        attempt_repository: object,
+        session_basename: str,
