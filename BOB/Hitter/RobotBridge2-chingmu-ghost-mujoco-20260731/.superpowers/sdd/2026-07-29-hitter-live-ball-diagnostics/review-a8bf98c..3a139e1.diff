+          + ' · frame ' + formatOptional(
+            ballSubject.source_frame,
+            (item) => String(item),
+          ),
+      );
+
+      const estimatorStatus = statusText(ball.status);
+      setCardStatus('ball-estimator-card', estimatorStatus);
+      setText(
+        byId('estimator-value'),
+        estimatorStatus + ' · ' + formatCountPair(
+          ball.estimator_sample_count,
+          ball.estimator_window_size,
