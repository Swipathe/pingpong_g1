+      setText(
+        byId('gate-task-value'),
+        taskStatus + ' · ' + formatCountPair(
+          gate.task_observation_valid_dimensions,
+          gate.task_observation_total_dimensions,
+        ),
+      );
+      setText(
+        byId('gate-task-detail'),
+        'clip count ' + formatOptional(
+          gate.task_observation_clip_count,
+          (item) => String(item),
+        ),
+      );
+
+      const meta = byId('attempt-meta');
+      meta.replaceChildren();
+      if (!live) {
+        [
+          'Attempt UNKNOWN',
+          '速度 —',
+          '预测击球 —',
+          'planner TTS —',
+          'ARM threshold —',
+        ].forEach(
+          (item) => meta.appendChild(makeElement('span', 'badge', item)),
+        );
+      } else if (!attempt) {
+        meta.appendChild(makeElement('span', '', '当前无 active attempt'));
+      } else {
+        const items = [
+          'Attempt #' + String(attempt.attempt_id),
