+    publish_time_us: Optional[int]
+    received_monotonic_s: Optional[float]
+    wall_time_us: Optional[int]
+
+    def __post_init__(self) -> None:
+        object.__setattr__(
+            self,
+            "position_w",
+            _readonly_float32(
+                self.position_w,
+                shape=(3,),
+                field="position_w",
+            ),
+        )
+        object.__setattr__(
+            self,
+            "quaternion_xyzw",
+            _readonly_float32(
+                self.quaternion_xyzw,
+                shape=(4,),
+                field="quaternion_xyzw",
+            ),
+        )
+
+
+@dataclass(frozen=True)
+class AdapterOutput:
