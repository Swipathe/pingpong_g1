+def _percentile_ms(values_s, quantile: float) -> float:
+    ordered = sorted(float(value) for value in values_s)
+    if not ordered:
+        raise AssertionError("no handler timings were recorded")
+    index = max(0, int(math.ceil(quantile * len(ordered))) - 1)
