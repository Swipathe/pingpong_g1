+    estimator_window_size: int,
+    argv: Sequence[str],
+) -> Mapping[str, Any]:
+    commit, dirty = _git_snapshot(_REPO_ROOT)
+    packages = _package_versions()
+    config_hashes = {
+        "mimic": _sha256_file(options.mimic_config),
+        "control": _sha256_file(options.control_config),
+    }
+    calibration_hashes = {
