+        "robot_anchor_quaternion_xyzw": np.asarray(
+            [0.0, 0.0, 0.0, 1.0],
+            dtype=np.float64,
+        ),
+        "base_target_xy_w": np.asarray([3.0, 5.0], dtype=np.float64),
+        "racket_target_position_w": np.asarray(
+            [4.0, 6.0, 1.5],
+            dtype=np.float64,
