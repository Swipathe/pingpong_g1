+    @property
+    def background_threads_alive(self) -> bool:
+        return any(
+            thread is not None and thread.is_alive()
+            for thread in (
+                self._lcm_thread,
+                self._input_thread,
+                self._tick_thread,
+                self._recorder_thread,
+                self._replay_thread,
+            )
