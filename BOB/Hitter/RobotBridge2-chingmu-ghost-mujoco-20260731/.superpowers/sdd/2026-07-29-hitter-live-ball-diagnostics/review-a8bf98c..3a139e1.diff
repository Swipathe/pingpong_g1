+@dataclass(frozen=True)
+class _PreparedDraft:
+    kind: str
+    monotonic_s: float
+    wall_time_us: int
+    scope: str
+    attempt_id: Optional[int]
+    payload: Mapping[str, JsonValue]
+    encoded_size_upper: int
