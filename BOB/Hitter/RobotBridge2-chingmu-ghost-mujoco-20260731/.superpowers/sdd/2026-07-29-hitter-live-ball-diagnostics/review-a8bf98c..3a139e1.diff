+class _SteppingClock:
+    def __init__(self, values: Iterable[float]) -> None:
+        self._values = iter(values)
+        self._last = 0.0
+        self._lock = threading.Lock()
+
+    def __call__(self) -> float:
+        with self._lock:
+            try:
+                self._last = float(next(self._values))
+            except StopIteration:
+                pass
+            return self._last
