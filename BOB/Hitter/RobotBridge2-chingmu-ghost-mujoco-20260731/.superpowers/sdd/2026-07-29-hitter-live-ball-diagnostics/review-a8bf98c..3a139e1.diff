+  </main>
+
+  <script>
+    'use strict';
+
+    const MIN_REQUEST_INTERVAL_MS = 100;
+    const REQUEST_WINDOW_MS = 1000;
+    const MAX_REQUESTS_PER_WINDOW = 10;
+    let renderedWatermark = -1;
+    let lastRequestStartedMs = -MIN_REQUEST_INTERVAL_MS;
+    let requestStartTimesMs = [];
+    let refreshPending = false;
+    let refreshTimer = null;
+    let requestInFlight = false;
+    let eventSource = null;
+    let reconnectTimer = null;
+    let reconnectDelayMs = 500;
+    let nextBefore = null;
+    let historyRows = [];
+
+    const byId = (id) => document.getElementById(id);
+
+    const formatOptional = (value, formatter) =>
+      value === null || value === undefined ? '—' : formatter(value);
+
+    function setText(node, value) {
+      node.textContent = formatOptional(value, (item) => String(item));
+    }
+
+    function formatNumber(value, digits, suffix) {
+      return formatOptional(value, (item) => {
+        const numeric = Number(item);
+        return Number.isFinite(numeric)
+          ? numeric.toFixed(digits) + (suffix || '')
+          : '—';
+      });
+    }
+
+    function formatCountPair(count, total) {
+      if (
+        count === null || count === undefined ||
+        total === null || total === undefined
+      ) {
+        return '—';
+      }
+      const numericCount = Number(count);
+      const numericTotal = Number(total);
+      if (
+        !Number.isInteger(numericCount) ||
+        !Number.isInteger(numericTotal) ||
+        numericCount < 0 ||
+        numericTotal < 0
+      ) {
+        return '—';
+      }
+      return String(numericCount) + '/' + String(numericTotal);
+    }
+
+    function formatVector(value, digits, suffix) {
+      if (!Array.isArray(value) || value.length !== 3) {
+        return '—';
+      }
+      const numeric = value.map((item) => Number(item));
+      if (!numeric.every((item) => Number.isFinite(item))) {
+        return '—';
+      }
+      return '[' + numeric.map((item) => item.toFixed(digits)).join(', ')
+        + ']' + (suffix || '');
+    }
+
+    function statusText(value) {
+      return (
+        typeof value === 'string' && value.trim()
+          ? value.trim().toUpperCase()
+          : 'UNKNOWN'
+      );
+    }
+
+    function formatFlag(value) {
+      if (value === true) {
+        return 'TRUE';
+      }
+      if (value === false) {
+        return 'FALSE';
+      }
+      return '—';
+    }
+
+    function formatHealthFlag(value, trueLabel, falseLabel) {
+      if (value === true) {
+        return trueLabel;
+      }
+      if (value === false) {
+        return falseLabel;
+      }
+      return 'UNKNOWN';
+    }
+
+    function liveSnapshotFor(state) {
+      if (
+        Number(state?.schema_version) !== 2 ||
+        !state.live_snapshot ||
+        typeof state.live_snapshot !== 'object' ||
+        Number(state.live_snapshot.schema_version) !== 2
+      ) {
+        return null;
+      }
+      return state.live_snapshot;
+    }
+
+    function schemaNotice(state) {
+      const stateSchema = Number(state?.schema_version);
+      if (Number.isFinite(stateSchema) && stateSchema > 2) {
+        return 'UNSUPPORTED_SCHEMA：后端 schema_version '
+          + String(state.schema_version) + '，停止猜测实时值。';
+      }
+      if (stateSchema !== 2 || !('live_snapshot' in (state || {}))) {
+        return '旧版后端状态：缺少 live_snapshot；请重启 diagnostics 服务。';
+      }
+      if (state.live_snapshot === null) {
+        return '结构化实时快照尚不可用；等待下一次 monitor tick。';
+      }
+      if (
+        typeof state.live_snapshot !== 'object' ||
+        Number(state.live_snapshot.schema_version) !== 2
+      ) {
+        return 'UNSUPPORTED_SCHEMA：live_snapshot 版本不受支持，停止猜测实时值。';
+      }
+      return null;
+    }
+
+    function statusClass(value) {
+      const status = statusText(value);
+      if (new Set([
+        'LIVE',
+        'VALID',
+        'READY',
+        'CONFIRMED',
+        'INCOMING',
+        'ARMED',
+        'AVAILABLE',
+        'PASS',
+        'COMPLETE',
+      ]).has(status)) {
+        return 'pass';
+      }
+      if (new Set([
+        'ESTIMATING',
+        'CONFIRMING',
+        'PENDING',
+        'NOT_ARMED',
+      ]).has(status)) {
+        return 'progress';
+      }
+      if (new Set([
+        'INVALID',
+        'REJECTED',
+        'FAILED',
+        'ERROR',
+      ]).has(status)) {
+        return 'fail';
+      }
+      return 'warn';
+    }
+
+    function setCardStatus(cardId, status) {
+      const node = byId(cardId);
+      node.className = 'stage';
+      node.classList.add(statusClass(status));
+    }
+
+    function makeElement(tag, className, text) {
+      const element = document.createElement(tag);
+      if (className) {
+        element.className = className;
+      }
+      if (text !== undefined) {
+        setText(element, text);
+      }
+      return element;
+    }
+
+    function setConnection(online, message) {
+      const node = byId('connection-status');
+      node.classList.toggle('offline', !online);
+      setText(node, message);
+    }
+
+    function metric(label, value) {
+      const card = makeElement('div', 'metric');
+      card.appendChild(makeElement('span', 'metric-label', label));
+      card.appendChild(makeElement('span', 'metric-value', value));
+      return card;
+    }
+
+    function subjectMetric(label, subject) {
+      const value = subject && typeof subject === 'object' ? subject : {};
+      return metric(
+        label,
+        [
+          statusText(value.status),
+          formatNumber(value.rate_hz, 1, ' Hz'),
+          formatNumber(value.age_s, 3, ' s'),
+          'frame ' + formatOptional(
+            value.source_frame,
+            (item) => String(item),
+          ),
+        ].join(' · '),
+      );
+    }
+
+    function renderHealth(state) {
+      const health = state.health || {};
+      const live = liveSnapshotFor(state);
+      const subjects = live && live.subjects ? live.subjects : {};
+      const warnings = Array.isArray(health.warnings)
+        ? health.warnings.map((item) => String(item))
+        : [];
+      const plannerCounts = [
+        health.planner_submitted,
+        health.planner_completed,
+        health.planner_failed,
+      ];
+      const plannerCountText = plannerCounts.some(
+        (item) => item === null || item === undefined,
+      )
+        ? '—'
+        : plannerCounts.map((item) => String(item)).join(' / ');
+      const values = [
+        subjectMetric('BALL', subjects.ball),
+        subjectMetric('PELVIS', subjects.g1pelvis),
+        subjectMetric('TABLE', subjects.table),
+        metric(
+          'transport',
+          formatHealthFlag(health.lcm_connected, 'ONLINE', 'OFFLINE'),
+        ),
+        metric('planner S/C/F', plannerCountText),
+        metric(
+          'planner drops',
+          formatOptional(
+            health.planner_dropped_pending,
+            (item) => String(item),
+          )
+            + ' pending · '
+            + formatOptional(
+              health.planner_results_overwritten_before_consume,
+              (item) => String(item),
+            )
+            + ' result',
+        ),
+        metric(
+          'phase',
+          statusText(state.lifecycle && state.lifecycle.phase),
+        ),
+        metric(
+          'diagnostic drops',
+          formatOptional(
+            health.raw_samples_dropped,
+            (item) => String(item),
+          )
+            + ' raw · '
+            + formatOptional(
+              health.diagnostic_events_dropped,
+              (item) => String(item),
+            )
+            + ' event',
+        ),
+        metric(
+          'recorder',
+          formatHealthFlag(
+            health.recorder_healthy,
+            'HEALTHY',
+            'DEGRADED',
+          ),
+        ),
+        metric(
+          'recording',
+          formatHealthFlag(
+            health.recording_complete,
+            'COMPLETE',
+            'INCOMPLETE',
+          ),
+        ),
+        metric(
+          'config',
+          formatOptional(health.config_name, (item) => String(item)),
+        ),
+        metric(
+          'session',
+          formatOptional(health.session_basename, (item) => String(item)),
+        ),
+      ];
+      const grid = byId('health-grid');
+      grid.replaceChildren(...values);
+      const warningPanel = byId('health-warnings');
+      if (warnings.length > 0) {
+        const warningList = makeElement('ul');
+        warnings.forEach((warning) => {
+          warningList.appendChild(makeElement('li', '', warning));
+        });
+        warningPanel.replaceChildren(
+          makeElement('strong', '', '健康告警'),
+          warningList,
+        );
+        warningPanel.hidden = false;
+      } else {
+        warningPanel.replaceChildren();
+        warningPanel.hidden = true;
+      }
+      const heartbeatStale = warnings.includes('LCM_HEARTBEAT_STALE');
+      const connected = Boolean(health.lcm_connected) && !heartbeatStale;
+      let connectionMessage = 'LCM 数据在线';
+      if (heartbeatStale) {
+        connectionMessage = 'LCM 数据离线：心跳超时；保留最近画面';
+      } else if (!connected) {
+        connectionMessage = 'LCM 数据离线；保留最近画面';
+      }
+      setConnection(connected, connectionMessage);
+    }
+
+    function renderCurrentAttempt(state) {
+      const live = liveSnapshotFor(state);
+      const subjects = live && live.subjects ? live.subjects : {};
+      const ballSubject = subjects.ball || {};
+      const pelvisSubject = subjects.g1pelvis || {};
+      const ball = live && live.ball ? live.ball : {};
+      const gate = live && live.production_gate
+        ? live.production_gate
+        : {};
+      const attempt = live ? live.current_attempt : null;
+
+      const schemaMessage = schemaNotice(state);
+      const liveNotice = byId('live-schema-notice');
+      liveNotice.classList.toggle('visible', schemaMessage !== null);
+      setText(liveNotice, schemaMessage === null ? '' : schemaMessage);
+
+      const ballSubjectStatus = statusText(ballSubject.status);
+      setCardStatus('ball-status-card', ballSubjectStatus);
+      setText(byId('ball-status-value'), ballSubjectStatus);
+      setText(
+        byId('ball-status-detail'),
+        'rate ' + formatNumber(ballSubject.rate_hz, 1, ' Hz')
