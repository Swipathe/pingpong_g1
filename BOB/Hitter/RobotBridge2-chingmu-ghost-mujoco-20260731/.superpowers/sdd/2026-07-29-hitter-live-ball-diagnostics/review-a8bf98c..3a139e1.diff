+            ball.last_estimator_reset_reason,
+            (item) => String(item),
+          ),
+      );
+
+      const diagnosticIncomingStatus = statusText(ball.incoming_status);
+      setCardStatus('ball-incoming-card', diagnosticIncomingStatus);
+      setText(
+        byId('ball-incoming-value'),
+        diagnosticIncomingStatus + ' · ' + formatCountPair(
+          ball.ball_only_incoming_count,
+          ball.ball_only_incoming_required,
+        ),
+      );
+      setText(
+        byId('ball-incoming-detail'),
+        'confirmed ' + formatFlag(ball.ball_only_incoming_confirmed)
+          + ' · blocker ' + formatOptional(
+            ball.blocker,
+            (item) => String(item),
+          ),
+      );
+
+      setText(
+        byId('ball-raw-position-value'),
+        formatVector(ball.raw_position_w, 3, ' m'),
