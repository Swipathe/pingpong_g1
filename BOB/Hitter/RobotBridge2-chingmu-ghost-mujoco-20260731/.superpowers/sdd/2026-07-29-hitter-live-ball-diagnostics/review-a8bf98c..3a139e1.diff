+            oldest = self._ring[0].event_id if self._ring else watermark + 1
+            if after_event_id is None:
+                mode = "fresh"
+                next_event_id = watermark + 1
+            elif (
+                after_event_id < 0
+                or after_event_id > watermark
+                or after_event_id < oldest - 1
+            ):
