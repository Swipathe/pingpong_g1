+            event = prepared.bind(event_id)
+            fallback = prepared.fallback
+
+            try:
+                next_state = self._reducer(self._state, event)
+            except _InvalidDraft:
+                prepared = invalid_fallback
+                event = prepared.bind(event_id)
+                fallback = True
+                next_state = self._reducer(self._state, event)
