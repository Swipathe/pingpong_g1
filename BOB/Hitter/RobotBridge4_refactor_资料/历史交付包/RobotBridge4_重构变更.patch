+```bash
+cd /home/yhl/Desktop/RobotBridge4_refactor
+PYTHONPATH=/tmp/rb4-refactor-tools:$PWD/deploy:$PWD \
+PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 MUJOCO_GL=egl \
+/home/yhl/miniforge3/envs/isaaclab/bin/python -m pytest \
