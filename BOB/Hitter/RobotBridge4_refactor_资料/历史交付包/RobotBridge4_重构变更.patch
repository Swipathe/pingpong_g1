+Quat Normalize(Quat q) {
+    const double n = std::sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w);
+    if (n < 1.0e-12)
+        return {};
+    q.x /= n;
+    q.y /= n;
+    q.z /= n;
+    q.w /= n;
+    if (q.w < 0.0) {
+        q.x = -q.x;
+        q.y = -q.y;
+        q.z = -q.z;
+        q.w = -q.w;
+    }
+    return q;
+}
