<?xml version="1.0"?>
<robot name="pelvis_target_marker">
    <link name="pelvis_target">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.001"/>
            <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://unitree_description/meshes/g1/pelvis.STL"/>
            </geometry>
            <material name="target_green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
        </visual>
    </link>
</robot>
